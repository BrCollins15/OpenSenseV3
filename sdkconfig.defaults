# OpenSense sdkconfig.defaults
# Only values that differ from ESP-IDF defaults.

# ── Flash ─────────────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ── NVS ───────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ── RF calibration ────────────────────────────────────────────────────────────
# Store RF calibration in NVS so it survives between boots.
# Without this, RF re-calibrates on every boot, causing degraded signal and
# failed WPA2 handshakes on first connect.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y

# ── WiFi buffers ───────────────────────────────────────────────────────────────
# RX: 32 dynamic buffers absorb burst traffic from the browser.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# TX: 16 dynamic buffers — 32 was overkill and consumed ~51 KB heap at peak,
# competing with cJSON allocations and causing intermittent malloc failures.
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# ── lwIP sockets ──────────────────────────────────────────────────────────────
# max_open_sockets(9) + 3 httpd internal = 12 minimum.
CONFIG_LWIP_MAX_SOCKETS=12

# ── lwIP TCP keepalive ────────────────────────────────────────────────────────
# Required for httpd keep_alive_enable to take effect.
CONFIG_LWIP_TCP_KEEPALIVE=y

# ── lwIP TCP buffer sizing ────────────────────────────────────────────────────
# Send buffer 8 KB: large enough to send app.js.gz (8.8 KB) in two chunks
# without stalling, small enough not to exhaust heap across 9 sockets.
# The previous value of 16 KB × 9 sockets × 2 directions = up to 288 KB of
# heap committed to TCP buffers alone — the ESP32 only has ~300 KB free DRAM.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192

# Receive window 5744: IDF default, well-tuned for ESP32. Increasing it
# caused Chrome to send data faster than the httpd task could drain, filling
# the heap and triggering EAGAIN on subsequent sends.
CONFIG_LWIP_TCP_WND_DEFAULT=5744

# ── HTTP Server ────────────────────────────────────────────────────────────────
CONFIG_HTTPD_WS_SUPPORT=y

# ── FreeRTOS ──────────────────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000

# ── Logging ───────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ── FAT / SD Card ─────────────────────────────────────────────────────────────
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ── ESP Timer ─────────────────────────────────────────────────────────────────
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# ── Partition Table ────────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
